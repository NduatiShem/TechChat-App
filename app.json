{
  "expo": {
    "name": "TechChat",
    "slug": "techchat",
    "version": "1.1.5",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/healtclassique-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/healtclassique-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.techchat.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ]
      }
    },
    "android": {
      "icon": "./assets/ic_launcher/android/playstore-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/ic_launcher/android/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundColor": "#283891"
      },
      "package": "com.techchat.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/icons/Icon-48.png"
    },
    "scheme": "techchat",
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "./plugins/withAndroidKeyboard.js",
      "./plugins/withGoogleServices.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/ic_launcher/android/ic_launcher-web.png",
          "color": "#283891"
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/plain",
            "text/*",
            "image/*",
            "application/pdf",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.ms-excel",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "application/vnd.ms-powerpoint",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation"
          ],
          "androidMultiIntentFilters": [
            "text/plain",
            "text/*",
            "image/*",
            "application/pdf",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.ms-excel",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "application/vnd.ms-powerpoint",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation"
          ],
          "androidMainActivityAttributes": {
            "android:launchMode": "singleTask",
            "android:windowSoftInputMode": "adjustResize"
          },
          "disableIOS": true
        }
      ]
    ],
    "notification": {
      "icon": "./assets/ic_launcher/android/ic_launcher-web.png",
      "color": "#283891",
      "iosDisplayInForeground": true,
      "androidMode": "collapse",
      "androidCollapsedTitle": "TechChat",
      "androidChannelId": "techchat-messages",
      "androidChannelName": "Messages",
      "androidChannelDescription": "New messages and notifications from TechChat"
    },
    "updates": {
      "url": "https://u.expo.dev/ff808b2d-601c-4c49-9969-b884cfb8b1e7",
      "fallbackToCacheTimeout": 3000,
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "enabled": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ff808b2d-601c-4c49-9969-b884cfb8b1e7"
      }
    },
    "owner": "shemnd"
  }
}
